{
  "name": "iobroker.chargemaster",
  "version": "0.16.0",
  "description": "Adapter for managing of multi EV-chargers with use of PV-energy",
  "author": {
    "name": "Hombach",
    "email": "chargemaster@homba.ch"
  },
  "homepage": "https://github.com/hombach/ioBroker.chargemaster",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "power",
    "energy",
    "chargemaster",
    "Smart Home",
    "home automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hombach/ioBroker.chargemaster.git"
  },
  "engines": {
    "node": ">= 22.18.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@iobroker/types": "^7.2.2",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.1",
    "set-value": "^4.1.0",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "io-package.json",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build:ts": "tsc -p tsconfig.build.json",
    "build": "npm run build:ts",
    "watch:ts": "tsc -p tsconfig.build.json --watch",
    "watch": "npm run watch:ts",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package && npm run test:integration",
    "check": "tsc --noEmit",
    "lint": "eslint -c eslint.config.mjs .",
    "lintdebug": "eslint --debug -c eslint.config.mjs . | more",
    "make": "npm run lint && npm run build && npm run test",
    "translate": "translate-adapter",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/hombach/ioBroker.chargemaster/issues"
  },
  "readmeFilename": "README.md"
}
